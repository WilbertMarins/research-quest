APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://research_quest:research_quest@localhost:5432/research_quest

# Crie a chave em https://console.groq.com/keys e mantenha o valor apenas no .env local.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384

MAX_UPLOAD_BYTES=2097152
MAX_CHUNKS_PER_DOCUMENT=2000
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5
